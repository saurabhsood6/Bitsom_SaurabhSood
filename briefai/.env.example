# BriefAI Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Key (required for AI-powered brief generation)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NewsAPI Key (optional — enables real news fetching instead of mock data)
# Get yours at https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# SMTP Email Configuration (optional — enables email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
